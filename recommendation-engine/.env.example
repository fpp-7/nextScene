# ─────────────────────────────────────────────
#  NextScene — Variáveis de Ambiente
#  Copie este arquivo para .env e preencha os valores
# ─────────────────────────────────────────────

# TMDB API — só usada pelo pipeline de treino, para enriquecer metadados.
# O treino roda sem ela com --skip-tmdb.
TMDB_API_KEY=your_tmdb_api_key_here
TMDB_BASE_URL=https://api.themoviedb.org/3

# Dataset paths
MOVIELENS_SMALL_PATH=data/raw/ml-latest-small
MOVIELENS_FULL_PATH=data/raw/ml-latest

# Environment: "development" usa o dataset small, "production" usa o full
ENV=development

# PostgreSQL — só usado por scripts/export_app_ratings.py (re-treino com os
# ratings do app). A API do motor não fala com banco.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nextscene
DB_USER=postgres
DB_PASSWORD=postgres

# Acima do maior userId do ml-latest (200.948, conferido em 2026-08). Raramente
# precisa mudar — só se o MovieLens crescer além disso.
MOVIELENS_USER_ID_OFFSET=1000000
