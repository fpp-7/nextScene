# ─────────────────────────────────────────────
#  NextScene — Variáveis de Ambiente
#  Copie este arquivo para .env e preencha os valores
# ─────────────────────────────────────────────

# TMDB API
TMDB_API_KEY=your_tmdb_api_key_here
TMDB_BASE_URL=https://api.themoviedb.org/3

# JWT
SECRET_KEY=your_super_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/nextscene

# Dataset paths
MOVIELENS_SMALL_PATH=data/raw/ml-latest-small
MOVIELENS_FULL_PATH=data/raw/ml-latest

# Environment: "development" usa o dataset small, "production" usa o full
ENV=development
