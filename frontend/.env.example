# ──────────────────────────────────────────────────
#  NextScene — Frontend (Expo)
#  Copie para `.env` e ajuste. Variáveis EXPO_PUBLIC_* são
#  embutidas no bundle em build time — nunca coloque segredos aqui.
# ──────────────────────────────────────────────────

# Emulador Android:            http://10.0.2.2:8080/api/v1
# Simulador iOS / Expo web:    http://localhost:8080/api/v1
# Dispositivo físico na LAN:   http://<IP-DA-SUA-MAQUINA>:8080/api/v1
EXPO_PUBLIC_API_URL=http://localhost:8080/api/v1
