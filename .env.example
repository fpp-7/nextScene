# ──────────────────────────────────────────────────
#  NextScene — Environment Variables
#  Copie para `.env` e ajuste. O `.env` real NÃO deve ser versionado.
# ──────────────────────────────────────────────────

# PostgreSQL
POSTGRES_DB=nextscene
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-esta-senha

# JWT — gere um segredo forte, mínimo 32 caracteres:
#   openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION=1800000

# CORS — origens permitidas, separadas por vírgula.
# Em produção, restrinja aos domínios reais do app.
APP_CORS_ALLOWED_ORIGINS=http://localhost:*,http://10.*:*,http://192.168.*:*,exp://*

# TMDB — obtenha em https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Recommendation Engine (uso interno do docker-compose)
RECOMMENDATION_ENGINE_URL=http://recommendation-engine:8000
