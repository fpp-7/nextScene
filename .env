# ──────────────────────────────────────────────────
#  NextScene — Environment Variables
#  Copy to .env and adjust as needed
# ──────────────────────────────────────────────────

# PostgreSQL
POSTGRES_DB=nextscene
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# JWT
JWT_SECRET=nextscene-super-secret-key-change-in-production
JWT_EXPIRATION=1800000

# TMDB (optional — for recommendation engine enrichment)
TMDB_API_KEY=033f05568a4e06d3491ac9c699299e65

# Recommendation Engine URL (used internally by docker-compose)
RECOMMENDATION_ENGINE_URL=http://recommendation-engine:8000
